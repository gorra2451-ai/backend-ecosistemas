#!/usr/bin/env bash
# Antes de cada commit: nada directo a main, ningún .env y ninguna llave.
. "$(git rev-parse --show-toplevel)/scripts/lib.sh"

# 1. Commits directos a main. Se permite solo el primer commit del repo.
if git rev-parse --verify -q HEAD >/dev/null && [ "$(rama_actual)" = "main" ]; then
  bloquear "commit directo a main. Crea tu rama: scripts/nueva-tarea.sh F1-T1 descripcion"
fi

# 2. Archivos .env y 3. llaves en las líneas agregadas.
problemas=""
while IFS= read -r archivo; do
  [ -z "$archivo" ] && continue
  case "$(basename "$archivo")" in
    .env.example) ;;
    .env|.env.*) problemas="$problemas\n  $archivo: los archivos .env no se suben" ;;
  esac
  if git diff --cached -U0 --no-color -- "$archivo" | grep '^+' | grep -v '^+++' | grep -Eq "$RE_SECRETO"; then
    problemas="$problemas\n  $archivo: contiene algo que parece una llave secreta"
  fi
done <<< "$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -n "$problemas" ]; then
  printf "✘ BLOQUEADO: el commit trae secretos:%b\n" "$problemas" >&2
  echo "  Saca el archivo con: git reset HEAD <archivo>. Las llaves van en .env (ignorado por git)." >&2
  exit 1
fi
